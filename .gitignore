# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 虚拟环境
venv/
env/
.env
.venv

# IDE 配置（如果你想让不同电脑共享配置，可以删掉这一行）
.idea/
.vscode/

# 数据集（千万不能上传！）
data/*.csv
data/*.xlsx
data/*.zip
!data/README.md  # 如果你在data里放说明文件，可以保留

# Jupyter Notebook 缓存
.ipynb_checkpoints/
*.ipynb

# 模型文件（二进制文件很大，不要上传）
*.pkl
*.h5
*.joblib

# 日志文件
logs/
*.log

# 系统文件
.DS_Store
Thumbs.db